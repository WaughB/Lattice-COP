# Tampa-COP settings. Copy to .env and fill in. Never commit .env.
# Comments sit on their own lines so every tool that reads this file agrees
# on the values.

# --- Lattice Sandboxes (required) ---
# Environment hostname from the Sandboxes dashboard, without https://
# (for example lattice-xxxx.env.sandboxes.developer.anduril.com).
LATTICE_URL=
# Account-level Sandboxes token (sent as Anduril-Sandbox-Authorization).
LATTICE_SANDBOXES_TOKEN=
# Use the environment token, or the client ID and secret pair. Not both.
LATTICE_ENVIRONMENT_TOKEN=
LATTICE_CLIENT_ID=
LATTICE_CLIENT_SECRET=

# --- AISStream (required) ---
AISSTREAM_API_KEY=

# --- Area of interest (Tampa Bay defaults) ---
AOI_SOUTH=27.40
AOI_WEST=-83.00
AOI_NORTH=28.20
AOI_EAST=-82.25
ADSB_CENTER_LAT=27.9755
ADSB_CENTER_LON=-82.5332
ADSB_RADIUS_NM=60

# --- ADS-B source ---
# receiver (your RTL-SDR via readsb) or adsbx (ADS-B Exchange, personal use only).
ADSB_SOURCE=receiver
ADSB_RECEIVER_URL=http://readsb/data/aircraft.json
# Your antenna location. Private: this is your home. Never commit it.
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_ALT_M=
# Only if ADSB_SOURCE=adsbx. Poll interval must respect your plan's monthly quota.
ADSBX_RAPIDAPI_KEY=
ADSBX_POLL_SECONDS=60
# Calls per month your ADS-B Exchange plan allows. Required if ADSB_SOURCE=adsbx:
# ADSBX_POLL_SECONDS must be at least 2592000 / ADSBX_MONTHLY_QUOTA.
ADSBX_MONTHLY_QUOTA=

# --- Receiver signal gate (sdr-check) ---
# How long sdr-check watches the receiver, in minutes. Run it in daytime.
SDR_CHECK_MINUTES=30
# Pass marks: unique aircraft seen inside the area of interest, median position
# age in seconds, and the farthest aircraft from the antenna in nautical miles.
SDR_CHECK_MIN_AIRCRAFT=20
SDR_CHECK_MAX_MEDIAN_SEEN_POS=5
SDR_CHECK_MIN_RANGE_NM=30

# --- Data cleaning ---
# AIS: drop messages older than this many seconds, and positions that imply a
# speed above this many knots since the last kept position.
AIS_MAX_AGE_SECONDS=300
AIS_MAX_SPEED_KN=50
# true also keeps MMSIs that are not ships (coast stations, aids to navigation,
# search-and-rescue aircraft, beacons).
AIS_ALLOW_NON_VESSEL_MMSI=false
# How long a vessel's name, call sign, type, size and destination are remembered.
AIS_STATIC_CACHE_SECONDS=21600
# ADS-B: drop positions older than this many seconds, and positions that imply
# a speed above this many knots since the last kept position.
ADSB_MAX_POSITION_AGE_SECONDS=15
ADSB_MAX_SPEED_KN=1000
# true also keeps non-ICAO addresses (hex starting with ~, such as TIS-B).
ADSB_ALLOW_NON_ICAO=false
# Extra distance, in nautical miles, allowed before a move counts as a position jump.
POSITION_JUMP_SLACK_NM=0.1

# --- Tuning ---
AIS_EXPIRY_SECONDS=600
ADSB_EXPIRY_SECONDS=60
AIS_THROTTLE_SECONDS=10
ADSB_THROTTLE_SECONDS=2
# Geoid height at Tampa (EGM96: -26.7 m). Added to barometric altitude to
# approximate height above the WGS84 ellipsoid when no geometric altitude is sent.
GEOID_OFFSET_M=-26.7
# How many updates each ingest service sends to Lattice at the same time.
# Sandboxes environments reject bursts, so keep this low.
PUBLISH_CONCURRENCY=2
LOG_LEVEL=INFO
