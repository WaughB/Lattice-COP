# Lattice-COP settings. Copy to .env and fill in. Never commit .env.
# Comments sit on their own lines so every tool that reads this file agrees
# on the values.

# --- Lattice Sandboxes (required) ---
# Environment hostname from the Sandboxes dashboard, without https://
# (for example lattice-xxxx.env.sandboxes.developer.anduril.com).
LATTICE_URL=
# Account-level Sandboxes token (sent as Anduril-Sandbox-Authorization).
LATTICE_SANDBOXES_TOKEN=
# Use the environment token, or the client ID and secret pair. Not both.
LATTICE_ENVIRONMENT_TOKEN=
LATTICE_CLIENT_ID=
LATTICE_CLIENT_SECRET=

# --- AISStream (required) ---
AISSTREAM_API_KEY=

# --- Area of interest (Tampa Bay defaults) ---
AOI_SOUTH=27.40
AOI_WEST=-83.00
AOI_NORTH=28.20
AOI_EAST=-82.25
ADSB_CENTER_LAT=27.9755
ADSB_CENTER_LON=-82.5332
ADSB_RADIUS_NM=60

# --- ADS-B source ---
# receiver (your RTL-SDR via readsb) or adsbx (ADS-B Exchange, personal use only).
ADSB_SOURCE=receiver
ADSB_RECEIVER_URL=http://readsb/data/aircraft.json
# Your antenna location. Private: this is your home. Never commit it.
RECEIVER_LAT=
RECEIVER_LON=
RECEIVER_ALT_M=
# Only if ADSB_SOURCE=adsbx. Poll interval must respect your plan's monthly quota.
ADSBX_RAPIDAPI_KEY=
ADSBX_POLL_SECONDS=60

# --- Tuning ---
AIS_EXPIRY_SECONDS=600
ADSB_EXPIRY_SECONDS=60
AIS_THROTTLE_SECONDS=10
ADSB_THROTTLE_SECONDS=2
# Geoid height at Tampa (EGM96, approximate). Used when only barometric altitude is known.
GEOID_OFFSET_M=-28
LOG_LEVEL=INFO
